# Copy to .env and fill in. .env is git-ignored. Never commit real keys.
# The server reads .env itself (Node's process.loadEnvFile); no dotenv needed.

# ---------------------------------------------------------------- Server
PORT=8790
# Bind address. 127.0.0.1 for local runs; the Docker image sets HOST=0.0.0.0 inside the container.
HOST=127.0.0.1
# Leave empty/0 unless the app sits behind a reverse proxy or tunnel you control. When set (1, or the number of
# proxy hops), the per-IP rate limit uses CF-Connecting-IP, else X-Forwarded-For. When unset those headers are
# ignored, because clients can forge them.
TRUST_PROXY=

# ---------------------------------------------------------------- Qloo (event-issued key)
# Server-side only. It is passed to the local `qloo mcp` child process and never sent
# to the browser. Do not paste it anywhere else.
QLOO_API_KEY=
# Optional: path to a different `qloo` executable. Default: the harness installed in node_modules.
# QLOO_BIN=

# ---------------------------------------------------------------- LLM: Nebius Token Factory (OpenAI-compatible)
# Source: Nebius Token Factory docs (docs.tokenfactory.nebius.com/quickstart), checked 2026-10-02.
# The model key is read from NEBIUS_API_KEY and nothing else. Generic names (LLM_API_KEY, OPENAI_API_KEY, LLM_BASE_URL,
# LLM_MODEL...) are ignored on purpose: they often belong to another tool in the same shell. The other settings below
# carry a SHELFWISE_ prefix for the same reason.
# Note: .env never overrides a variable that is already set in the environment (Node's process.loadEnvFile), even one
# set to an empty string. If a value here has no effect, check whether it is already exported in your shell.
# In sample-data mode (DEMO_FIXTURES=1) the planner is a scripted placeholder; setting NEBIUS_API_KEY makes it call the
# real model on sample Qloo data instead.
NEBIUS_API_KEY=
SHELFWISE_LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# NVIDIA Nemotron model on Token Factory. Copy ids exactly; casing in Nebius's catalog is inconsistent.
# Default: Nemotron 3 Super (120B total / 12B active, 256K context). Alternative: nvidia/Nemotron-3-Ultra-550b-a55b
SHELFWISE_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# Optional JSON merged into every chat-completions request body, for provider-specific switches
# (for example a reasoning toggle). Leave empty unless `npm run check:llm` tells you to.
# SHELFWISE_LLM_EXTRA_BODY={}
SHELFWISE_LLM_TIMEOUT_MS=90000
# Max tokens the model may generate per turn (the report is the longest output).
SHELFWISE_LLM_MAX_TOKENS=4096

# ---------------------------------------------------------------- Modes
# DEMO_FIXTURES=1 runs the UI on clearly-labelled SAMPLE data (no keys needed). It is never used
# automatically: if this is unset and keys are missing, the server reports "not configured".
DEMO_FIXTURES=

# ---------------------------------------------------------------- Agent limits
AGENT_MAX_STEPS=14
AGENT_MAX_TOOL_CALLS=24
AGENT_MAX_RETRIES=2
# Per session (a form run plus all its follow-ups): total Qloo tool calls and number of follow-up messages.
AGENT_MAX_SESSION_TOOL_CALLS=60
MAX_SESSION_FOLLOWUPS=12
QLOO_CALL_TIMEOUT_MS=45000
QLOO_CONCURRENCY=3

# ---------------------------------------------------------------- Protecting the Qloo quota (public demo)
# New runs (the form) per IP per hour, follow-up messages/choices per IP per hour, and a global daily budget of
# Qloo tool calls after which the demo says it is at capacity until tomorrow (UTC).
RATE_LIMIT_RUNS_PER_HOUR=6
RATE_LIMIT_MESSAGES_PER_HOUR=40
QLOO_DAILY_CALL_BUDGET=1500
# Agent runs execute at most this many at a time; extra runs wait in a visible queue (up to MAX_QUEUE).
MAX_CONCURRENT_RUNS=2
MAX_QUEUE=8
QUEUE_WAIT_TIMEOUT_SEC=120
# Response cache for Qloo tool results, keyed by tool + normalised inputs.
CACHE_TTL_MINUTES=720
CACHE_MAX_ENTRIES=500
